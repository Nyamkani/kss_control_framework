include(${CMAKE_CURRENT_LIST_DIR}/PackagingEnvironment.cmake)
kcf_detect_package_environment(Core)

# Packaging uses static archives and standalone executables.
if(BUILD_SHARED_LIBS)
    message(FATAL_ERROR "Phase-1 DEB packaging requires BUILD_SHARED_LIBS=OFF")
endif()
if(NOT CMAKE_INSTALL_PREFIX STREQUAL "/usr")
    message(FATAL_ERROR "DEB packaging requires CMAKE_INSTALL_PREFIX=/usr")
endif()
find_program(KCF_DPKG_SHLIBDEPS dpkg-shlibdeps)
if(NOT KCF_DPKG_SHLIBDEPS)
    message(FATAL_ERROR "DEB packaging requires dpkg-shlibdeps (dpkg-dev)")
endif()
set(CPACK_GENERATOR DEB)
set(CMAKE_INSTALL_DEFAULT_DIRECTORY_PERMISSIONS
    OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
set(CPACK_PACKAGE_NAME kcf-core)
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_VENDOR Nyamkani)
set(CPACK_PACKAGE_CONTACT "Nyamkani <Nyamkani@users.noreply.github.com>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "KCF Core runtime executables and C++17 development SDK")
set(CPACK_DEBIAN_PACKAGE_SECTION libdevel)
set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "https://github.com/Nyamkani/kss_control_framework")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
# No maintainer scripts, service units, host identity or configuration files.
include(CPack)
