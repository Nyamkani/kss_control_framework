# Optional CLI overrides, not a Network policy file. Defaults use automatic NIC.
# Do not override state-dir/lock-file in production or create a second lock domain.
KCF_GATEWAY_ARGS=
# For a multi-NIC host, for example:
# KCF_GATEWAY_ARGS="--interface enp1s0 --discovery-port 37651 --control-port 39001 --topic-port 37652"

# Publisher Topics are remotely subscribable by default on trusted LANs.
# For private-by-default behavior: KCF_GATEWAY_ARGS="--topic-default-deny"
# To expose only one prefix: KCF_GATEWAY_ARGS="--topic-allow-prefix /public"
# To expose everything except one prefix: KCF_GATEWAY_ARGS="--topic-exclude-prefix /private"
# Remote Parameter/Service/Action Control remains default denied.

# Remote Action status observation (default poll 10ms; terminal Result remains ~50ms):
# KCF_GATEWAY_ARGS="--action-status-mode poll --action-status-poll-ms 50"
# Or event-based Local Action SHM notification:
# KCF_GATEWAY_ARGS="--action-status-mode event"
# Combine with other options in one KCF_GATEWAY_ARGS value.
