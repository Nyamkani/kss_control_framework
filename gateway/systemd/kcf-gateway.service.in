[Unit]
Description=KCF Host Network Gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
# Render both placeholders before deployment. Use the SAME UID as Local Runtimes.
User=@KCF_GATEWAY_USER@
ExecStart=@KCF_GATEWAY_EXECUTABLE@ --state-dir /var/lib/kcf --lock-file /run/kcf/gateway.lock $KCF_GATEWAY_ARGS
EnvironmentFile=-/etc/kcf/gateway.env
StateDirectory=kcf
StateDirectoryMode=0700
RuntimeDirectory=kcf
RuntimeDirectoryMode=0700
# Retain lock inode across stops/restarts, including manual launchers.
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2
TimeoutStopSec=15
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
NoNewPrivileges=yes
# Do not isolate /dev/shm: same-UID Runtime registries must remain visible.
PrivateIPC=no
PrivateTmp=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
